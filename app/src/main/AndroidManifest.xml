<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".LoteriaVipApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Lotería VIP"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.LoteriaVIP">

        <!-- AdMob App ID (test ID – replace with your real ID before publishing) -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <!-- FCM: default channel for background notifications (notification payload) -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="loteria_vip_loterias_rd" />

        <!-- FCM: default notification color -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/green_primary" />

        <!-- Onboarding: shown once on first launch -->
        <activity
            android:name="com.loteriavip.app.presentation.screens.onboarding.OnboardingActivity"
            android:exported="true"
            android:theme="@style/Theme.LoteriaVIP">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.loteriavip.app.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.LoteriaVIP"/>

        <service
            android:name="com.loteriavip.app.data.notification.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
